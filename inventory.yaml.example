all:
  vars:
    ansible_winrm_transport: ntlm
    ansible_connection: winrm
    ansible_winrm_message_encryption: auto
    ansible_winrm_server_cert_validation: ignore
    ansible_port: 5985
    #remote_source: "\\\\192.168.88.70\\obmen\\autodownloads"
    dest: "C:\\temp\\deploy"
    telegram_token: "1234567890::LKDJFOSIEFLSKJEFSLKJEF"
    telegram_chat_id: -123456567890
    telegram_https_proxy: "http://192.168.88.70:1080"
    software_legacy_allow_unverified: true
    software_package_timeout: 180
    patterns__all:
      - { regex: "7z[\\d.]+-x64.exe", mode: "exe", args: ["/S"] }
      - { regex: "audacity-win-[\\d.]+-64bit.exe", mode: "exe", args: ["/S","/verysilent","/NORESTART"], pre: ["taskkill /im audacity* /f"] }
      - { regex: "draw.io-.*-windows-installer.exe", mode: "exe", args: ["/S","/verysilent","/NORESTART"] }
      - { regex: "Firefox", mode: "exe", args: ["/S","/verysilent","/NORESTART"] }
      - { regex: "inkscape-.+-x64(?:\\.signed)?\\.exe", mode: "exe", args: ["/S", '/D="C:\Program Files\Inkscape"'], pre: ['"C:\Program Files\Inkscape\Uninstall.exe" /S']  }
      - { regex: "K-Lite_Codec_Pack_.+_Mega.exe", mode: "exe", args: ["/S", "/VERYSILENT", "/NORESTART"] }
      - { regex: "libreoffice.*_Win_x86-64.msi", mode: "msi", args: ["/quiet", "/norestart"], pre: ['taskkill /im "soffice.*" /f'] }
      - { regex: "libreoffice.*help", mode: "msi", args: ["/quiet", "/norestart"] }
      - { regex: "mumble_client-[\\d.]+\\.x64\\.exe", mode: "exe", args: ["/quiet", "/norestart"] }
      - { regex: "Nextcloud-.*-x64.msi", mode: "msi", args: ["/quiet", "/norestart"], pre: ["taskkill /f /im nextcloud*"] }
      - { regex: "ShareX", mode: "exe", args: ["/VERYSILENT", "/NORESTART", "/NORUN"], pre: ['taskkill /t /f /im ShareX.exe'] }
      - { regex: "Thunderbird", mode: "exe", args: ["/S","/verysilent","/NORESTART"], pre: "taskkill /f /im thunderbird.exe" }
      - { regex: "tightvnc-[\\d.]+-gpl-setup-64bit.msi", state: "present", force: false, mode: "msi", product_id: "tightvnc.*", args: ["/quiet", "/norestart", "ADDLOCAL=Server"] }
      - { regex: "hide.reg", force: false, mode: "files", dest: 'C:\temp', files: ["hide.reg"], post: ['regedit /s C:\temp\hide.reg', 'sc stop tvnserver', 'sc start tvnserver'] }
      - { regex: "tor-browser", mode: "exe", args: ["/S", "/verysilent"] }
      - { regex: "vlc-[\\d.]+-win64.exe", mode: "exe", args: ["/S", "/verysilent"] }
      - { regex: "windows_exporter-.*-amd64.msi", mode: "msi", args: [ '/quiet', '/norestart', 'ENABLED_COLLECTORS="[defaults],process,textfile"', 'TEXTFILE_DIRS="C:\metrics"'], pre: ["sc stop windows_exporter"] }
      - { regex: "XnConvert-win-x64", mode: "exe", args: ["/S", "/verysilent"], force: false }
      - { regex: "XnViewMP-win-x64", mode: "exe", args: ["/S", "/verysilent"], force: false }
      ## updating too often
      #- { regex: "Far[\\d.ab]+.x64.[\\d]+.msi", mode: "msi", args: ["/quiet", "/norestart"] }
  children:
    dev_hosts:
      hosts:
        notebook:
      vars:
          patterns__dev_hosts:
            #- { regex: "python-[\\d.]+-amd64.exe", force: false, mode: "exe", args: ["/quiet", "InstallAllUsers=1", "PrependPath=1", "Include_pip=1", "AssociateFiles=1", "Include_doc=0", "Shortcuts=0", 'TargetDir="C:\Program Files\Python"'] }
            - { regex: "keepass", mode: "exe", args: ["/S", "/verysilent"], force: false, pre: ['taskkill /im "keepass.exe" /f'] }
            - { regex: "openconnect", mode: "exe", args: ["/S", "/verysilent"], force: false }
            - { regex: "openvpn", mode: "msi", args: ["/quiet", "/norestart"], force: false }
            - { regex: "putty-64bit-[\\d.]+-installer.msi", mode: "msi", args: ["/quiet", "/norestart"] }
            - { regex: "npp.+Installer.x64.exe", mode: "exe", args: ["/S", "/VERYSILENT", "/NORESTART"] }
            - { regex: "WinSCP-.*-Setup", mode: "exe", args: ["/S", "/VERYSILENT", "/NORESTART"] }
            - { regex: "Freelens-.*-windows-amd64.msi", mode: "msi", args: ["/quiet", "/norestart"], pre: ["taskkill /im Freelens* /f"] }
            - { regex: "tightvnc-[\\d.]+-gpl-setup-64bit.msi", state: "present", force: false, mode: "msi", product_id: "tightvnc.*", args: ["/quiet", "/norestart"] }
            # - { regex: "VSCodeUserSetup", mode: "exe", args: ["/VERYSILENT", "/CURRENTUSER", "/NORESTART", "/MERGETASKS=!runcode"] , pre: ["taskkill /im Code.exe /f"] }
            # - { regex: "HeidiSQL", mode: "exe", args: ["/SP", "/FORCECLOSEAPPLICATIONS", "/VERYSILENT", "/ALLUSERS", "/NORESTART"] }
            - { regex: "dbeaver", mode: "exe", args: ["/S", "/currentuser"] }
            - { regex: "tor-expert-bundle-windows-x86_64-[\\d.-]+.tar.gz", state: "present", mode: "arc", dest: "C:\\Program Files\\TorBundle", force: false, pre: [ "sc stop tor" ] }
            - { regex: "torrc", force: false, mode: "files", dest: 'C:\Program Files\TorBundle\tor', files: ["torrc","tor_install.bat"], post: ['"C:\Program Files\TorBundle\tor\tor_install.bat"'] }
            - { regex: "ffmpeg-master-latest-win64-gpl.zip", state: "present", mode: "arc", dest: 'C:\Program Files\', force: false, files: ["ffmpeg-master-latest-win64-gpl/bin/ffplay.exe","ffmpeg-master-latest-win64-gpl/bin/ffprobe.exe","ffmpeg-master-latest-win64-gpl/bin/ffmpeg.exe"]}
            # - { regex: "gimp", mode: "exe", args: ["/S", "/verysilent", "/currentuser"] }
    graphic_hosts:
      hosts:
        notebook:
      vars:
        patterns__graphic_hosts:
            - { regex: "krita-x64-[\\d.-]+-setup.exe", state: "present", product_id: "Krita.*", force: false, mode: "exe", args: ["/S", "/verysilent"] }
            - { regex: "gimp", mode: "exe", args: ["/S", "/verysilent", "/currentuser"] }

    lan_hosts:
      hosts:
        notebook:
      vars:
        patterns__lan_hosts:
          - { regex: "jami.release.x64.msi", force: "false", mode: "msi", args: ["/quiet", "/norestart"], pre: ["taskkill /f /im jami.exe"] }
          #- { regex: "transgui-[\\d.]+-setup_64bit.exe", mode: "exe", product_id: "Transmission.+GUI.*", args: ["/S", "/verysilent"], force: false}
          - { regex: "Nextcloud.Talk-windows-x64.msi", mode: "msi", args: ["/quiet", "/norestart"], pre: ["taskkill /im nextcloud* /f"] }

    win_hosts:
      hosts:
        notebook:
          patterns__notebook:
            - { state: "present", regex: "tesseract-ocr-w64-setup-[\\d.]+.exe", mode: "exe", args: ["/S"], product_id: "Tesseract-OCR" }
            - { regex: "blender-[\\d.]+-windows-x64\\.msi", mode: "msi", args: ["/quiet", "/norestart"] }
            - { regex: "calibre-64bit-.*\\.msi", mode: "msi", args: ["/quiet", "/norestart"] }
            - { regex: "VirtualBox-.*-Win.exe", state: "present", product_id: "Oracle.*VirtualBox.*", mode: "exe", args: ["--silent","--ignore-reboot"] }
            - { regex: "aimp.+\\.exe", mode: "exe", args: '/AUTO="C:\Users\{{ ansible_user }}\Desktop\AIMP" /SILENT', pre: ["taskkill /im aimp* /f"] }
            - { regex: "VeraCrypt_Setup_x64_[\\d.]+.msi", state: "present", product_id: "VeraCrypt.*", force: false, mode: "msi", args: ["/quiet", "ACCEPTLICENSE=YES", "/norestart"] }
            - { regex: "transgui-[\\d.]+-setup_64bit.exe", mode: "exe", product_id: "Transmission.+GUI.*", args: ["/VERYSILENT", "/SUPPRESSMSGBOXES", "/NORESTART", "/SP-", "/CLOSEAPPLICATIONS", "/FORCECLOSEAPPLICATIONS", '/LOG=C:\temp\transgui-install.log'], pre: ["taskkill /t /f /im transgui.exe"], force: false}
